# Copy to .env in this folder (same level as docker-compose.yml):
#   copy .env.example .env
# Edit values, then: docker compose up --build

# MySQL (used by compose + Spring API)
DB_NAME=mysewa
DB_PASSWORD=mysewa_local_dev_change_me

# Optional: expose MySQL on host port 3307 (container is still mysql:3306 internally)
MYSQL_PUBLISH_PORT=3307

# Web UI — open http://localhost:8888 after compose up
WEB_PORT=8888
APP_BASE_URL=http://localhost:8888

# Auth (change for anything beyond local dev)
JWT_SECRET=mysewa-jwt-local-dev-secret

# Bootstrap admin (created on API startup if missing)
APP_ADMIN_EMAIL=mysewa.fyp@gmail.com
APP_ADMIN_PASSWORD=Admin123

# Email (optional — leave blank to skip real SMTP in local Docker)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
