# Copy to .env in this folder (same level as docker-compose.yml):
#   copy .env.example .env
# Edit values, then: docker compose up --build
# NEVER put real passwords in this file — only placeholders (this file may be committed to git).

# MySQL (used by compose + Spring API)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=mysewa
DB_USER=root
DB_PASSWORD=

# Docker only: host port mapped to container 3306
MYSQL_PUBLISH_PORT=3307

# Web UI — VPS: WEB_PORT=80 and APP_BASE_URL=http://YOUR_DROPLET_IP
WEB_PORT=8888
APP_BASE_URL=http://localhost:8888
# WEB_DOCKERFILE=Dockerfile.prebuilt

# Auth (change for anything beyond local dev)
JWT_SECRET=change-me-long-random-secret

# AES-256-GCM key for NRIC (ic_number) at rest. Use a long random string; if empty, a dev-only default is derived (change in production).
MYSEWA_IC_ENCRYPTION_KEY=

# Bootstrap admin (created on API startup if missing; reconciles password/role on each start)
APP_ADMIN_EMAIL=admin@localhost
APP_ADMIN_PASSWORD=Admin123

# Demo accounts for login page (Student / Landlord rows; created on API startup)
MYSEWA_DEMO_ACCOUNTS=true
DEMO_STUDENT_EMAIL=student@demo.mysewa
DEMO_STUDENT_PASSWORD=Student123
DEMO_LANDLORD_EMAIL=landlord@demo.mysewa
DEMO_LANDLORD_PASSWORD=Landlord123

# Email (optional — leave blank to skip real SMTP in local Docker)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- ToyyibPay (deposit online) — see docs/PAYMENTS.md ---
TOYYIBPAY_ENABLED=false
TOYYIBPAY_SANDBOX=true
TOYYIBPAY_USER_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
APP_PUBLIC_API_URL=http://127.0.0.1:8090

MYSEWA_DEV_RESET_DEPOSIT=false

# Optional: manual bank / QR shown in “Pay deposit” modal
# PAYMENT_MANUAL_BANK_NAME=Maybank
# PAYMENT_MANUAL_BANK_ACCOUNT=1234567890
# PAYMENT_MANUAL_BANK_HOLDER=Your Name
# PAYMENT_MANUAL_QR_URL=https://example.com/your-duitnow-qr.png
